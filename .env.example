# Copiar a .env. Las credenciales se usan solo desde el servidor; nunca commitear valores reales.
# Fuentes de datos (ver docs/DATA_SOURCES.md)
FIRMS_MAP_KEY=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
FIRMS_MAX_DAY_RANGE=5
HARMONIZATION_VERSION=0.4.0
# Memory for the offline pipeline (packages/nina); the full archive build was run with 5GB.
NINA_BUILD_MEMORY_LIMIT=5GB
# Off by default: a draft is never presented as a scientifically validated dataset.
NINA_EXPERIMENTAL_HARMONIZATION=false

# Datos locales (rutas relativas a la raíz del repositorio)
# Originales (las descargas por API van a source/downloads/) y derivados (DuckDB, Parquet, cachés, modelos)
NINA_SOURCE_DIR=source
NINA_DATA_DIR=data
NINA_DUCKDB_MEMORY_LIMIT=2GB
NINA_DUCKDB_THREADS=2

# Opcional: endpoint compatible con Chat Completions. Sin él se usa un asistente determinista con evidencia.
NINA_LLM_BASE_URL=
NINA_LLM_API_KEY=
NINA_LLM_MODEL=

# Optional: analytical assistant (/api/analyst). With ANTHROPIC_API_KEY (or CLAUDE_API_KEY) set, Claude plans the tool calls and
# writes the answer; every figure is checked against the tool results. Without it, the deterministic engine answers.
ANTHROPIC_API_KEY=
NINA_ANALYST_MODEL=claude-sonnet-5-5
NINA_ANALYST_EFFORT=medium
# Set to "deterministic" to keep the assistant offline even when a key is present.
NINA_ANALYST_ENGINE=
