# Copiar a .env. Las credenciales se usan solo desde el servidor; nunca commitear valores reales.
# Fuentes de datos (ver docs/DATA_SOURCES.md)
FIRMS_MAP_KEY=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Datos locales (rutas relativas a la raíz del repositorio)
# Originales (las descargas por API van a source/downloads/) y derivados (DuckDB, Parquet, cachés, modelos)
NINA_SOURCE_DIR=source
NINA_DATA_DIR=data
NINA_DUCKDB_MEMORY_LIMIT=2GB
NINA_DUCKDB_THREADS=2

# Opcional: endpoint compatible con Chat Completions. Sin él se usa un asistente determinista con evidencia.
NINA_LLM_BASE_URL=
NINA_LLM_API_KEY=
NINA_LLM_MODEL=
