   "text": "fire-calendar/                      # raíz del monorepo\n├── apps/\n│   ├── web/                        # React + Vite + TS (mapa, calendario)\n│   └── api/                        # FastAPI (endpoints, export CSV)\n├── packages/\n│   ├── harmonization/              # lib Python: ingesta, QA, calibración\n│   ├── schemas/                    # OpenAPI → tipos TS / modelos Pydantic\n│   ├── ui/                         # CalendarHeatmap, MapView, RegionPicker\n│   └── config/                     # tsconfig, eslint, prettier, ruff\n├── pipelines/                      # flujos Prefect/Dagster (histórico + NRT)\n├── notebooks/                      # exploración y validación de armonización\n├── data/                           # (gitignored) raw/ interim/ harmonized/\n├── infra/                          # docker-compose, Dockerfiles, IaC\n├── docs/                           # metodología, ADRs, guía de usuario\n├── .github/workflows/              # CI por app/paquete afectado\n├── pnpm-workspace.yaml · turbo.json   # workspace JS/TS\n└── pyproject.toml · uv.lock           # workspace Python (uv)",
   "originalText": "fire-calendar/                      # raíz del monorepo\n├── apps/\n│   ├── web/                        # React + Vite + TS (mapa, calendario)\n│   └── api/                        # FastAPI (endpoints, export CSV)\n├── packages/\n│   ├── harmonization/              # lib Python: ingesta, QA, calibración\n│   ├── schemas/                    # OpenAPI → tipos TS / modelos Pydantic\n│   ├── ui/                         # CalendarHeatmap, MapView, RegionPicker\n│   └── config/                     # tsconfig, eslint, prettier, ruff\n├── pipelines/                      # flujos Prefect/Dagster (histórico + NRT)\n├── notebooks/                      # exploración y validación de armonización\n├── data/                           # (gitignored) raw/ interim/ harmonized/\n├── infra/                          # docker-compose, Dockerfiles, IaC\n├── docs/                           # metodología, ADRs, guía de usuario\n├── .github/workflows/              # CI por app/paquete afectado\n├── pnpm-workspace.yaml · turbo.json   # workspace JS/TS\n└── pyproject.toml · uv.lock           # workspace Python (uv)",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
