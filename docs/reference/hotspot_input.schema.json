{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "hotspot_input.schema.json",
    "title": "Entrada de focos FIRMS (AGENTS.md §6)",
    "type": "array",
    "items": {
        "type": "object",
        "required": [
            "latitude",
            "longitude",
            "acq_date",
            "acq_time",
            "confidence",
            "daynight",
            "frp",
            "instrument",
            "satellite"
        ],
        "additionalProperties": true,
        "properties": {
            "latitude": { "type": "number" },
            "longitude": { "type": "number" },
            "acq_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "acq_time": { "type": ["string", "integer"] },
            "scan": { "type": "number" },
            "track": { "type": "number" },
            "confidence": { "type": "string" },
            "daynight": { "type": "string" },
            "brightness": { "type": "number" },
            "bright_t31": { "type": "number" },
            "bright_ti4": { "type": "number" },
            "bright_ti5": { "type": "number" },
            "frp": { "type": "number" },
            "type": { "type": "string" },
            "instrument": { "type": "string" },
            "version": { "type": "string" },
            "satellite": { "type": "string" }
        },
        "allOf": [
            {
                "if": { "properties": { "instrument": { "const": "MODIS" } } },
                "then": { "required": ["brightness"] }
            },
            {
                "if": { "properties": { "instrument": { "const": "VIIRS" } } },
                "then": { "anyOf": [{ "required": ["bright_ti4"] }, { "required": ["brightness"] }] }
            }
        ]
    }
}
