{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NINA QA report",
  "type": "object",
  "required": ["method_version", "created_at", "input_reports", "input_revision", "qa_reasons", "mask_validation", "activity_rows", "cell_count", "status", "coverage", "gaps_by_reason", "suspicious_days", "low_confidence_fraction"],
  "properties": {
    "method_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "created_at": {"type": "string"},
    "input_revision": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "input_reports": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["filename", "sha256", "rows_read", "accepted", "rejected", "status"],
        "properties": {
          "filename": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "rows_read": {"type": "integer", "minimum": 0},
          "accepted": {"type": "integer", "minimum": 0},
          "rejected": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
          "status": {"const": "normalized"}
        }
      }
    },
    "qa_reasons": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "mask_validation": {
      "type": "object", "required": ["passed", "vegetation_removal_fraction", "static_recall"],
      "properties": {
        "passed": {"type": "boolean"},
        "vegetation_removal_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "static_recall": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "activity_rows": {"type": "integer", "minimum": 0},
    "cell_count": {"type": "integer", "minimum": 0},
    "status": {"const": "candidate_not_published"}
  }
}
