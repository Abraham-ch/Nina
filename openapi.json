  "components": {
    "schemas": {
      "Acquisition": {
        "properties": {
          "products": {
            "items": {
              "type": "string",
              "enum": [
                "MODIS_NRT",
                "MODIS_SP",
                "VIIRS_NOAA20_NRT",
                "VIIRS_NOAA20_SP",
                "VIIRS_NOAA21_NRT",
                "VIIRS_NOAA21_SP",
                "VIIRS_SNPP_SP"
              ]
            },
            "type": "array",
            "maxItems": 3,
            "minItems": 1,
            "title": "Products",
            "default": [
              "MODIS_NRT",
              "VIIRS_NOAA20_NRT",
              "VIIRS_NOAA21_NRT"
            ]
          },
          "start": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start"
          },
          "days": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Days",
            "default": 1
          },
          "scope": {
            "type": "string",
            "enum": [
              "world",
              "PER",
              "custom"
            ],
            "title": "Scope",
            "default": "world"
          },
          "geometry": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Geometry"
          }
        },
        "type": "object",
        "title": "Acquisition"
      },
      "ArchiveMonth": {
        "properties": {
          "product": {
            "type": "string",
            "enum": [
              "MODIS_NRT",
              "MODIS_SP",
              "VIIRS_NOAA20_NRT",
              "VIIRS_NOAA20_SP",
              "VIIRS_NOAA21_NRT",
              "VIIRS_NOAA21_SP",
              "VIIRS_SNPP_SP"
            ],
            "title": "Product"
          },
          "year": {
            "type": "integer",
            "maximum": 2100.0,
            "minimum": 2000.0,
            "title": "Year"
          },
          "month": {
            "type": "integer",
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Month"
          },
          "scope": {
            "type": "string",
            "enum": [
              "world",
              "PER",
              "custom"
            ],
            "title": "Scope",
            "default": "custom"
          },
          "geometry": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Geometry"
          }
        },
        "type": "object",
        "required": [
          "product",
          "year",
          "month"
        ],
        "title": "ArchiveMonth"
      },
      "Body_upload_api_import_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "source": {
            "type": "string",
            "enum": [
              "modis",
              "viirs-snpp",
              "viirs-jpss1",
              "viirs-jpss2"
            ],
            "title": "Source"
          },
          "coverage_start": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Coverage Start"
          },
          "coverage_end": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Coverage End"
          },
          "spatial_scope": {
            "type": "string",
            "enum": [
              "PER",
              "world",
              "custom"
            ],
            "title": "Spatial Scope",
            "default": "PER"
          },
          "spatial_geometry": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spatial Geometry"
          }
        },
        "type": "object",
        "required": [
          "file",
          "source"
        ],
        "title": "Body_upload_api_import_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Login"
      },
      "Question": {
        "properties": {
          "analysis_id": {
            "type": "string",
            "title": "Analysis Id"
          },
          "question": {
            "type": "string",
            "maxLength": 600,
            "minLength": 1,
            "title": "Question"
          },
          "role": {
            "type": "string",
            "enum": [
              "gestion",
              "ciencia",
              "comunicacion"
            ],
            "title": "Role",
            "default": "gestion"
          }
        },
        "type": "object",
        "required": [
          "analysis_id",
          "question"
        ],
        "title": "Question"
      },
      "Register": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 3,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 200,
            "minLength": 8,
            "title": "Password"
          },
          "role": {
            "type": "string",
            "enum": [
              "visitante",
              "analista",
              "admin"
            ],
            "title": "Role",
            "default": "analista"
